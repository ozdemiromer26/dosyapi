#!/usr/bin/env bash
# dosyapı sunucu yönetim aracı (Docker kurulumu). kur.sh tarafından /usr/local/bin altına kurulur.
# Kullanım: sudo dosyapi-ctl <command>   — komut listesi için: dosyapi-ctl help
set -euo pipefail

DIR="${DOSYAPI_DIR:-/opt/dosyapi}"
BACKUPS="$DIR/yedekler"
KEEP_BACKUPS="${DOSYAPI_KEEP_BACKUPS:-14}"
APP_UID=10001

die() { echo "Hata: $*" >&2; exit 1; }
info() { echo "› $*"; }
yes_no() {
  local answer
  read -r -p "$1 (evet/hayır) " answer < /dev/tty
  case "${answer,,}" in evet|e|yes|y) return 0 ;; *) return 1 ;; esac
}

case "${1:-help}" in help|-h|--help|yardim) ;; *)
  [ -f "$DIR/compose.yml" ] || die "$DIR altında kurulum bulunamadı."
  [ "$(id -u)" -eq 0 ] || die "Bu komut root yetkisi ister: sudo dosyapi-ctl $*"
  cd "$DIR" ;;
esac

dc() { docker compose --project-directory "$DIR" -f "$DIR/compose.yml" "$@"; }
app() { dc exec -T dosyapi dosyapi --config /data/config.toml "$@"; }
env_get() { [ -f "$DIR/.env" ] || return 0; sed -n "s/^$1=//p" "$DIR/.env" | tail -n1; }
env_set() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp "$DIR/.env.XXXXXX")"
  grep -v "^$key=" "$DIR/.env" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$DIR/.env"
}

# Uygulama konteyneri çalışıyor mu?
running() { [ -n "$(dc ps -q --status running dosyapi 2>/dev/null || true)" ]; }

# Uygulama sağlıklı mı? Caddy imajındaki wget ile iç ağdan /healthz sorulur.
healthy() {
  dc exec -T caddy wget -q -T 3 -O /dev/null http://dosyapi:8080/healthz >/dev/null 2>&1
}

wait_healthy() {
  local _
  for _ in $(seq 1 "${1:-60}"); do
    healthy && return 0
    sleep 1
  done
  return 1
}

current_digest() {
  local id
  id="$(dc ps -q dosyapi 2>/dev/null || true)"
  [ -n "$id" ] || return 0
  docker inspect -f '{{.Image}}' "$id" 2>/dev/null \
    | xargs -r docker image inspect -f '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' 2>/dev/null || true
}

# Derleme için bellek: Rust sürüm derlemesi ~2-3 GB ister. Bellek + takas yetmiyorsa
# derleme süresince geçici takas dosyası açılır, bitince kaldırılır.
TEMP_SWAP=""
ensure_swap() {
  local mem swap
  mem="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
  swap="$(awk '/SwapTotal/{print $2}' /proc/meminfo)"
  if [ $((mem + swap)) -lt 3500000 ] && [ ! -e /swapfile-dosyapi ]; then
    echo "› Bellek az; derleme için geçici 3 GB takas alanı açılıyor…" >&2
    fallocate -l 3G /swapfile-dosyapi 2>/dev/null || dd if=/dev/zero of=/swapfile-dosyapi bs=1M count=3072 status=none
    chmod 600 /swapfile-dosyapi
    mkswap /swapfile-dosyapi >/dev/null
    swapon /swapfile-dosyapi
    TEMP_SWAP=1
  fi
}
drop_swap() {
  if [ -n "$TEMP_SWAP" ]; then
    swapoff /swapfile-dosyapi 2>/dev/null || true
    rm -f /swapfile-dosyapi
  fi
}

# Kaynak koddan imaj derler; yalnızca yeni imaj etiketini stdout'a yazar.
# Kullanım: dosyapi-ctl build [ref] [repo]   (ref: main ya da v1.2.3)
cmd_build() {
  local ref="${1:-}" repo="${2:-}" src="$DIR/kaynak" tag avail
  [ -n "$ref" ] || ref="$(env_get DOSYAPI_SOURCE_REF)"
  ref="${ref:-main}"
  [ -n "$repo" ] || repo="$(env_get DOSYAPI_REPO)"
  [ -n "$repo" ] || die "Depo bilinmiyor (DOSYAPI_REPO)."
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Geçersiz kaynak dalı/etiketi: $ref"
  avail="$(df -Pk /var/lib/docker 2>/dev/null | awk 'NR==2{print $4}' || echo 0)"
  [ "${avail:-0}" -ge 6000000 ] || echo "Uyarı: Docker diskinde 6 GB'tan az boş yer var; derleme yarıda kalabilir." >&2
  if [ ! -f "$src/Dockerfile" ] || [ "${DOSYAPI_FRESH:-1}" = 1 ]; then
    rm -rf "$src"; install -d -m 0755 "$src"
    echo "› Kaynak kod indiriliyor ($repo @ $ref)" >&2
    curl -fsSL "https://codeload.github.com/$repo/tar.gz/$ref" | tar -xz -C "$src" --strip-components=1
  fi
  tag="dosyapi-yerel:$(date +%Y%m%d%H%M%S)"
  ensure_swap
  trap drop_swap EXIT
  echo "› Derleniyor: $tag (tek çekirdekli sunucuda 20-30 dakika sürebilir)" >&2
  if ! docker build -t "$tag" "$src" >&2; then
    die "Derleme başarısız. Bellek yetmediyse sunucuya takas ekleyip tekrar deneyin."
  fi
  drop_swap; trap - EXIT
  # Son 3 yerel imaj kalır (geri dönüş için), eskiler silinir.
  docker images dosyapi-yerel --format '{{.Tag}}' | sort -r | tail -n +4 \
    | sed 's/^/dosyapi-yerel:/' | xargs -r docker rmi >/dev/null 2>&1 || true
  echo "$tag"
}

cmd_status() {
  dc ps
  if healthy; then echo "Uygulama: çalışıyor"
  elif running; then echo "Uygulama: açılıyor ya da YANIT VERMİYOR (dosyapi-ctl logs)"
  else echo "Uygulama: ÇALIŞMIYOR (başlatmak için: sudo dosyapi-ctl start)"; fi
  echo "Sürüm imajı: $(env_get DOSYAPI_IMAGE_REF)"
  echo "Adres: https://$(env_get DOSYAPI_DOMAIN)"
  echo "Veri: $DIR/data   Yedekler: $BACKUPS"
}

cmd_start() {
  dc up -d
  if wait_healthy 90; then info "Çalışıyor: https://$(env_get DOSYAPI_DOMAIN)"
  else die "Uygulama 90 sn içinde yanıt vermedi. Günlükler: sudo dosyapi-ctl logs"; fi
}

# Tutarlı yedek: uygulama çalışıyorsa birkaç saniye durdurulur, veri klasörü (veritabanı,
# şifreli dosyalar, yapılandırma ve gizli anahtar) arşivlenir, sonra yeniden başlatılır.
cmd_backup() {
  local stamp file was_running=0
  [ -d "$DIR/data" ] || die "Yedeklenecek veri yok ($DIR/data)."
  install -d -m 0700 "$BACKUPS"
  stamp="$(date +%Y%m%d-%H%M%S)"
  file="$BACKUPS/dosyapi-$stamp.tar.gz"
  if running; then
    was_running=1
    info "Uygulama kısa süreliğine durduruluyor…"
    dc stop dosyapi >/dev/null
  fi
  tar -czf "$file" -C "$DIR" data .env
  chmod 600 "$file"
  [ "$was_running" = 1 ] && dc start dosyapi >/dev/null
  info "Yedek: $file ($(du -h "$file" | cut -f1))"
  echo "  Bu arşiv gizli anahtarı da içerir; sunucu dışında güvenli bir yerde saklayın."
  # Eski yedekleri temizle (en yeni $KEEP_BACKUPS kalır).
  # Dosya adları yalnızca dosyapi-YYYYmmdd-HHMMSS.tar.gz olduğu için ls sıralaması güvenli.
  # shellcheck disable=SC2012
  ls -1t "$BACKUPS"/dosyapi-*.tar.gz 2>/dev/null | tail -n +"$((KEEP_BACKUPS + 1))" | xargs -r rm -f
  if [ "$was_running" = 1 ]; then
    wait_healthy 60 || echo "Uyarı: yedekten sonra uygulama henüz yanıt vermiyor; 'dosyapi-ctl logs' ile bakın." >&2
  fi
}

cmd_restore() {
  local file="${1:-}" stamp
  [ -f "$file" ] || die "Yedek dosyası verin: dosyapi-ctl restore $BACKUPS/dosyapi-....tar.gz"
  tar -tzf "$file" data/config.toml >/dev/null 2>&1 || die "Bu dosya bir dosyapı yedeği değil."
  echo "Mevcut veriler $DIR/data.eski-* olarak kenara alınacak ve yedek geri yüklenecek."
  if [ "${2:-}" != "--yes" ]; then
    yes_no "Devam edilsin mi?" || die "Vazgeçildi."
  fi
  stamp="$(date +%Y%m%d-%H%M%S)"
  dc stop dosyapi >/dev/null 2>&1 || true
  [ -d "$DIR/data" ] && mv "$DIR/data" "$DIR/data.eski-$stamp"
  tar -xzf "$file" -C "$DIR" data
  chown -R "$APP_UID:$APP_UID" "$DIR/data"
  chmod 700 "$DIR/data"
  dc up -d >/dev/null
  if wait_healthy 90; then
    info "Geri yüklendi. Önceki veriler: $DIR/data.eski-$stamp"
  else
    die "Uygulama açılmadı; önceki veriler $DIR/data.eski-$stamp içinde duruyor."
  fi
}

# Güncelleme: önce yedek, sonra yeni imaj. Sağlıklı açılmazsa önceki imaja dönülür.
cmd_update() {
  local target="${1:-}" image previous new_ref ref
  image="$(env_get DOSYAPI_IMAGE)"
  [ -n "$image" ] || die ".env içinde DOSYAPI_IMAGE yok; kurulum tamamlanmamış. Yeniden kurun (kur.sh)."
  if [ -n "$target" ]; then
    [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || die "Geçersiz sürüm: $target"
  fi
  if [ "$(env_get DOSYAPI_SOURCE)" = "1" ]; then
    # Kaynak kurulumu: önceki yerel imaj etiketi geri dönüş için saklanır.
    previous="$(env_get DOSYAPI_IMAGE_REF)"
    ref="$(env_get DOSYAPI_SOURCE_REF)"; ref="${ref:-main}"
    [ -n "$target" ] && ref="v$target"
    new_ref="$(cmd_build "$ref")" || die "Derleme başarısız; çalışan sürüm değişmedi."
    info "Güncelleme öncesi yedek alınıyor…"
    cmd_backup
    env_set DOSYAPI_IMAGE_REF "$new_ref"
  else
    new_ref="$image:${target:-latest}"
    previous="$(current_digest)"
    info "Güncelleme öncesi yedek alınıyor…"
    cmd_backup
    info "İmaj indiriliyor: $new_ref"
    env_set DOSYAPI_IMAGE_REF "$new_ref"
    if ! dc pull dosyapi; then
      [ -n "$previous" ] && env_set DOSYAPI_IMAGE_REF "$previous"
      die "İmaj indirilemedi; hiçbir şey değişmedi."
    fi
  fi
  dc up -d
  if wait_healthy 90; then
    info "Güncellendi: $new_ref"
    docker image prune -f >/dev/null 2>&1 || true
    return 0
  fi
  echo "Yeni sürüm sağlıklı açılmadı; önceki sürüme dönülüyor." >&2
  if [ -n "$previous" ]; then
    env_set DOSYAPI_IMAGE_REF "$previous"
    dc up -d
    wait_healthy 90 && die "Önceki sürüme dönüldü ($previous). Günlükler: dosyapi-ctl logs"
  fi
  die "Uygulama açılmıyor. Son yedekten dönmek için: dosyapi-ctl restore <yedek>"
}

cmd_token() {
  running || die "Uygulama çalışmıyor. Önce başlatın: sudo dosyapi-ctl start"
  app setup-token
  dc restart dosyapi >/dev/null
  wait_healthy 60 || true
  echo "Belirteç yalnızca ilk kurulum tamamlanmamışsa işe yarar."
}

cmd_auto_update() {
  case "${1:-}" in
    on|ac)
      cat > /etc/systemd/system/dosyapi-update.service <<UNIT
[Unit]
Description=dosyapı otomatik güncelleme
After=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/dosyapi-ctl update
UNIT
      cat > /etc/systemd/system/dosyapi-update.timer <<UNIT
[Unit]
Description=dosyapı gece güncellemesi
[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=30m
Persistent=true
[Install]
WantedBy=timers.target
UNIT
      systemctl daemon-reload
      systemctl enable --now dosyapi-update.timer
      info "Otomatik güncelleme açık: her gece 04:00 civarı (öncesinde yedek alınır)." ;;
    off|kapat)
      systemctl disable --now dosyapi-update.timer 2>/dev/null || true
      rm -f /etc/systemd/system/dosyapi-update.service /etc/systemd/system/dosyapi-update.timer
      systemctl daemon-reload
      info "Otomatik güncelleme kapalı." ;;
    *) die "Kullanım: dosyapi-ctl auto-update on|off" ;;
  esac
}

cmd_uninstall() {
  echo "Servisler durdurulup kaldırılacak. Veriler ($DIR/data) ve yedekler SİLİNMEZ;"
  echo "kur.sh yeniden çalıştırılırsa aynı verilerle kurulur."
  yes_no "Devam edilsin mi?" || die "Vazgeçildi."
  cmd_auto_update off >/dev/null 2>&1 || true
  dc down
  info "Kaldırıldı. Verileri de tamamen silmek için: sudo rm -rf $DIR"
}

usage() {
  cat <<'HELP'
dosyapı yönetim aracı — kullanım: sudo dosyapi-ctl <command>

  status                    Servislerin durumu, sürüm ve adres
  logs [-f]                 Uygulama günlükleri (-f: canlı izle)
  start                     Servisleri başlat
  restart                   Servisleri yeniden başlat
  backup                    Tutarlı yedek al (çalışıyorsa birkaç saniyelik kesinti)
  restore <file> [--yes]    Yedekten geri yükle
  update [version]          Yedek alıp en yeni (ya da belirtilen) sürüme geç; sorun olursa geri döner
                            (kaynak kurulumunda sunucuda yeniden derler)
  build [ref]               Kaynak koddan imaj derle (ref: main ya da v1.2.3)
  auto-update on|off        Gece otomatik güncelleme
  token                     Yeni ilk kurulum belirteci üret
  master-reset              Master şifreyi ve master iki adımlı doğrulamayı sıfırla
  uninstall                 Servisleri kaldır (veriler kalır)
HELP
}

# Türkçe eski adlar uyumluluk için kabul edilir.
case "${1:-help}" in
  status|durum) cmd_status ;;
  logs|gunluk) shift; dc logs --tail 200 "$@" dosyapi ;;
  start|baslat) cmd_start ;;
  restart|yeniden-baslat)
    if running; then
      dc restart
      if wait_healthy 90; then info "Çalışıyor."; else die "Yanıt yok; günlükler: sudo dosyapi-ctl logs"; fi
    else cmd_start; fi ;;
  backup|yedekle) cmd_backup ;;
  restore|geri-yukle) shift; cmd_restore "$@" ;;
  update|guncelle) shift; cmd_update "$@" ;;
  build|derle) shift; cmd_build "$@" ;;
  auto-update|otomatik-guncelleme) shift; cmd_auto_update "$@" ;;
  token|belirtec) cmd_token ;;
  # Yeni şifreyi terminalden sorar; bu yüzden etkileşimli (-T olmadan) çalışır.
  master-reset|master-sifirla)
    running || die "Uygulama çalışmıyor. Önce başlatın: sudo dosyapi-ctl start"
    dc exec dosyapi dosyapi --config /data/config.toml master-reset ;;
  uninstall|kaldir) cmd_uninstall ;;
  help|-h|--help|yardim) usage ;;
  *) echo "Bilinmeyen komut: $1" >&2; echo >&2; usage >&2; exit 1 ;;
esac
